#!/bin/sh
# ubus/rpcd backend for luci-app-xkeen-smartroute.
# Filename registers the ubus object as "luci.xkeen-smartroute" (rpcd's
# script-protocol convention: object name == filename under this directory).
# Protocol: `list` prints the method schema, `call <method>` reads JSON args
# from stdin and prints a JSON result.

LIB_DIR="/opt/share/xkeen-smartroute/lib"
SR_ETC_DIR="/etc/xkeen-smartroute"

json_err() { printf '{"error":"%s"}\n' "$1"; }

# ubus/rpcd rejects a bare top-level JSON array as a script result ("Invalid
# argument") -- every array-shaped result must be wrapped in an object.
# wrap_array <field> <json-array-or-empty> -> {"<field>": [...]}
wrap_array() {
	field="$1"; content="$2"
	[ -n "$content" ] || content='[]'
	printf '%s' "$content" | jq --arg f "$field" '{($f): (. // [])}' 2>/dev/null \
		|| printf '{"%s":[]}' "$field"
}

case "$1" in
	list)
		cat <<'EOF'
{
	"list_servers": {},
	"import_subscription": {"url":"str1","label":"str1","client":"str1","os":"str1","locale":"str1","model":"str1","ver":"str1","hwid":"str1"},
	"random_hwid": {},
	"list_categories": {},
	"list_custom_categories": {},
	"list_profiles": {},
	"save_profile": {"profile":"str1"},
	"delete_profile": {"name":"str1"},
	"add_custom_domain": {"list_name":"str1","domains":"str1"},
	"get_status": {},
	"killswitch_set": {"name":"str1","enabled":"bool1"},
	"list_killswitch_enabled": {},
	"ping_servers": {},
	"get_refresh_hours": {},
	"set_refresh_hours": {"hours":"str1"},
	"refresh_now": {}
}
EOF
		;;
	call)
		method="$2"
		args="$(cat)"
		[ -x "$LIB_DIR/common.sh" ] || { json_err "not_installed"; exit 0; }
		case "$method" in
			list_servers)
				wrap_array servers "$(sh "$LIB_DIR/subscription.sh" list 2>/dev/null)"
				;;
			import_subscription)
				url="$(echo "$args" | jq -r '.url // empty')"
				label="$(echo "$args" | jq -r '.label // "sub"')"
				client="$(echo "$args" | jq -r '.client // "smartroute"')"
				os_ov="$(echo "$args" | jq -r '.os // empty')"
				locale_ov="$(echo "$args" | jq -r '.locale // empty')"
				model_ov="$(echo "$args" | jq -r '.model // empty')"
				ver_ov="$(echo "$args" | jq -r '.ver // empty')"
				hwid_ov="$(echo "$args" | jq -r '.hwid // empty')"
				if [ -z "$url" ]; then json_err "missing_url"; exit 0; fi
				if sh "$LIB_DIR/subscription.sh" import "$url" "$label" "$client" "$os_ov" "$locale_ov" "$model_ov" "$ver_ov" "$hwid_ov" >/tmp/sr_import.log 2>&1; then
					wrap_array servers "$(sh "$LIB_DIR/subscription.sh" list 2>/dev/null)"
				else
					jq -n --arg log "$(cat /tmp/sr_import.log)" '{error:"import_failed", detail:$log}'
				fi
				;;
			random_hwid)
				if [ -r /proc/sys/kernel/random/uuid ]; then
					hwid="$(cat /proc/sys/kernel/random/uuid | tr -d '\n')"
				elif command -v od >/dev/null 2>&1; then
					hwid="$(head -c 16 /dev/urandom 2>/dev/null | od -An -tx1 | tr -d ' \n')"
				else
					hwid="sr$(date +%s)$$"
				fi
				jq -n --arg hwid "$hwid" '{hwid:$hwid}'
				;;
			list_categories)
				wrap_array categories "$(cat "$SR_ETC_DIR/lists/geosite-categories.json" 2>/dev/null)"
				;;
			list_custom_categories)
				wrap_array categories "$(cat "$SR_ETC_DIR/lists/custom-categories.json" 2>/dev/null)"
				;;
			list_profiles)
				wrap_array profiles "$(sh "$LIB_DIR/genroute.sh" list 2>/dev/null)"
				;;
			save_profile)
				echo "$args" | jq -r '.profile' >/tmp/sr_profile.json
				if sh "$LIB_DIR/genroute.sh" save /tmp/sr_profile.json >/tmp/sr_save.log 2>&1; then
					jq -n '{ok:true}'
				else
					jq -n --arg log "$(cat /tmp/sr_save.log)" '{error:"save_failed", detail:$log}'
				fi
				;;
			delete_profile)
				name="$(echo "$args" | jq -r '.name // empty')"
				[ -n "$name" ] || { json_err "missing_name"; exit 0; }
				sh "$LIB_DIR/genroute.sh" delete "$name" >/tmp/sr_del.log 2>&1
				jq -n '{ok:true}'
				;;
			add_custom_domain)
				list_name="$(echo "$args" | jq -r '.list_name // empty' | tr -cs 'A-Za-z0-9_-' '_')"
				domains="$(echo "$args" | jq -r '.domains // empty')"
				[ -n "$list_name" ] && [ -n "$domains" ] || { json_err "missing_fields"; exit 0; }
				mkdir -p "$SR_ETC_DIR/lists/custom"
				echo "$domains" | tr ',' '\n' | sed 's/^ *//; s/ *$//' | grep -v '^$' >> "$SR_ETC_DIR/lists/custom/${list_name}.lst"
				sort -u -o "$SR_ETC_DIR/lists/custom/${list_name}.lst" "$SR_ETC_DIR/lists/custom/${list_name}.lst"
				jq -n --arg f "custom/${list_name}.lst" '{ok:true, file:$f}'
				;;
			get_status)
				running=0
				# pgrep -f '/opt/.*/xray' used to match by full command line,
				# but the process actually runs as bare "xray run" (no
				# resolved path in argv), while *any* unrelated command that
				# merely mentions /opt/etc/xray/configs/... in its arguments
				# (e.g. our own genroute.sh) matched instead -- wrong process,
				# false positive/negative depending on timing. Match by name.
				pgrep -x xray >/dev/null 2>&1 && running=1
				n_servers="$(sh "$LIB_DIR/subscription.sh" list 2>/dev/null | jq 'length' 2>/dev/null || echo 0)"
				n_profiles="$(sh "$LIB_DIR/genroute.sh" list 2>/dev/null | jq 'length' 2>/dev/null || echo 0)"
				jq -n --argjson running "$running" --argjson servers "$n_servers" --argjson profiles "$n_profiles" \
					'{xray_running:($running==1), server_count:$servers, profile_count:$profiles}'
				;;
			killswitch_set)
				name="$(echo "$args" | jq -r '.name // empty')"
				enabled="$(echo "$args" | jq -r '.enabled // false')"
				[ -n "$name" ] || { json_err "missing_name"; exit 0; }
				if [ "$enabled" = "true" ]; then
					sh "$LIB_DIR/killswitch.sh" enable "$name" >/tmp/sr_ks.log 2>&1
				else
					sh "$LIB_DIR/killswitch.sh" disable "$name" >/tmp/sr_ks.log 2>&1
				fi
				jq -n '{ok:true}'
				;;
			list_killswitch_enabled)
				wrap_array names "$(sh "$LIB_DIR/killswitch.sh" list-enabled 2>/dev/null)"
				;;
			ping_servers)
				out="$(sh "$LIB_DIR/subscription.sh" ping 2>/tmp/sr_ping.log)"
				[ -n "$out" ] || out='{}'
				printf '%s' "$out" | jq '{pings: (. // {})}' 2>/dev/null || echo '{"pings":{}}'
				;;
			get_refresh_hours)
				h="$(sh "$LIB_DIR/subscription.sh" get-refresh-hours 2>/dev/null)"
				jq -n --arg h "${h:-12}" '{hours: ($h|tonumber)}'
				;;
			set_refresh_hours)
				hours="$(echo "$args" | jq -r '.hours // empty')"
				if sh "$LIB_DIR/subscription.sh" set-refresh-hours "$hours" >/tmp/sr_refresh.log 2>&1; then
					jq -n '{ok:true}'
				else
					jq -n --arg log "$(cat /tmp/sr_refresh.log)" '{error:"invalid_hours", detail:$log}'
				fi
				;;
			refresh_now)
				sh "$LIB_DIR/subscription.sh" refresh-now >/tmp/sr_refresh_now.log 2>&1 &
				jq -n '{ok:true, note:"started in background"}'
				;;
			*) json_err "unknown_method" ;;
		esac
		;;
	*) echo "usage: $0 {list|call <method>}" >&2; exit 1 ;;
esac
